# Copy this file to .env and fill in your own RevenueCat API keys.
# Get these from the RevenueCat dashboard under Project Settings, API Keys.
# Never commit the real .env file.

EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# URL of the backend/api.py Flask server. From an Android emulator use
# http://10.0.2.2:5000, from a physical device use your machine's LAN IP,
# from a Codespace use the forwarded port URL once it's set to public.
EXPO_PUBLIC_API_URL=http://localhost:5000
